PORT=3000
DB_HOST=localhost
# Use 5433 if you run Postgres from docker-compose.yml (host maps 5433→5432)
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=taskflow
# Set to false in production; use migrations instead
TYPEORM_SYNC=true
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
